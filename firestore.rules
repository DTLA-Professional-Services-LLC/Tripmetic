rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin access is granted only through a Firebase Auth custom claim.
    // Do not add public email allowlists to this file.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Promo codes: Admin SDK / Cloud Functions only (no client access).
    match /appsumo_codes/{codeId} {
      allow read, write: if false;
    }

    // User profile docs written from web redeem + mobile auth.
    match /users/{userId} {
      function ownerSafeKeys() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'email',
            'displayName',
            'updatedAt',
            'lastLoginAt',
            'platform',
            'platformVersion'
          ]);
      }

      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.lifetime_access == false
        && request.resource.data.entitlement_status == 'none'
        && request.resource.data.get('banned', false) == false;
      allow update: if isAdmin() || (isOwner(userId) && ownerSafeKeys());
      allow delete: if false;

      // Existing bucket list subcollection (mobile app).
      match /bucket_list/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Keep existing public-ish config readable if present.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fiat_rates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /crypto_rates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Group trips are private to members. Invitation codes are the only
    // public lookup needed before a user signs in.
    function tripPath(tripId) {
      return /databases/$(database)/documents/group_trips/$(tripId);
    }

    function memberPath(tripId, userId) {
      return /databases/$(database)/documents/group_trips/$(tripId)/members/$(userId);
    }

    // Reads the trip owner after the current atomic write. This lets the
    // create-trip batch create the owner's membership and invite code while
    // still rejecting writes by non-members.
    function isTripOwnerAfterWrite(tripId) {
      return getAfter(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function isTripMember(tripId) {
      return isSignedIn() && exists(memberPath(tripId, request.auth.uid));
    }

    function isTripOwner(tripId) {
      return isSignedIn()
        && exists(tripPath(tripId))
        && get(tripPath(tripId)).data.ownerId == request.auth.uid;
    }

    function isTripAdminMember(tripId) {
      return isTripMember(tripId)
        && get(memberPath(tripId, request.auth.uid)).data.role == 'admin';
    }

    function isTripOwnerOrAdmin(tripId) {
      return isTripOwner(tripId) || isTripAdminMember(tripId);
    }

    function isTripPlanner(tripId) {
      return isTripOwnerOrAdmin(tripId)
        || (
          isTripMember(tripId)
          && get(memberPath(tripId, request.auth.uid)).data.role == 'co-planner'
        );
    }

    function isValidTripInvite(code, tripId) {
      return code is string
        && code.size() >= 6
        && code.size() <= 8
        && get(/databases/$(database)/documents/trip_invite_codes/$(code)).data.tripId == tripId;
    }

    match /group_trips/{tripId} {
      allow get: if isTripMember(tripId);
      allow list: if resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTripOwnerOrAdmin(tripId);

      match /members/{userId} {
        allow get: if isTripMember(tripId);
        allow list: if isTripMember(tripId)
          || resource.data.userId == request.auth.uid;
        allow create: if isTripOwnerOrAdmin(tripId)
          || (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'admin'
            && isTripOwnerAfterWrite(tripId)
          )
          || (
            userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'view-only'
            && request.resource.data.keys().hasAll(['inviteCode'])
            && isValidTripInvite(request.resource.data.inviteCode, tripId)
          );
        allow update, delete: if isTripOwnerOrAdmin(tripId);
      }

      match /activities/{activityId} {
        function canChangeOwnVote(activityId) {
          return isTripMember(tripId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['votes'])
            && request.resource.data.votes
              .diff(resource.data.votes)
              .addedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.votes
              .diff(resource.data.votes)
              .removedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.votes
              .diff(resource.data.votes)
              .changedKeys()
              .hasOnly([request.auth.uid]);
        }

        allow get: if isTripMember(tripId);
        allow list: if isTripMember(tripId);
        allow create, delete: if isTripPlanner(tripId);
        allow update: if isTripPlanner(tripId) || canChangeOwnVote(activityId);
      }
    }

    match /trip_invite_codes/{codeId} {
      // Direct reads are public so an invite link can resolve before sign-in.
      // Collection listing stays private to avoid exposing every active code.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['tripId'])
        && (
          isTripOwnerOrAdmin(request.resource.data.tripId)
          || isTripOwnerAfterWrite(request.resource.data.tripId)
        );
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.keys().hasAll(['tripId'])
        && isTripOwnerOrAdmin(resource.data.tripId);
    }
  }
}
