<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE ONLY — mock values, safe to commit.

  Copy to `GoogleService-Info.plist` and replace every `YOUR_…` value with the
  real ones from Firebase Console → Project settings → Your apps → iOS.

  Optionally supply them as --dart-define values instead (see
  lib/core/config/firebase_config.dart). The real GoogleService-Info.plist is
  git-ignored and must never be committed.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_FIREBASE_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>YOUR_FIREBASE_MESSAGING_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.tripmetic.app</string>
	<key>PROJECT_ID</key>
	<string>YOUR_FIREBASE_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>YOUR_FIREBASE_STORAGE_BUCKET</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>YOUR_FIREBASE_GOOGLE_APP_ID</string>
</dict>
</plist>
