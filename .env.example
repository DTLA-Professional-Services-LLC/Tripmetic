# TEMPLATE ONLY — mock values, safe to commit.
#
# Flutter app build-time configuration. Pass these to `flutter run` /
# `flutter build` as `--dart-define`, e.g.
#
#   flutter run \
#     --dart-define=MAPBOX_ACCESS_TOKEN=pk.… \
#     --dart-define=REVENUECAT_APPLE_KEY=appl.… \
#     --dart-define=REVENUECAT_GOOGLE_KEY=goog.…
#
# Or use `--dart-define-from-file=config/local.json` (git-ignored).
#
# See lib/core/config/app_secrets.dart and lib/core/config/firebase_config.dart
# for the code that consumes these.

# --- Mapbox ---------------------------------------------------------------
# Public access token (`pk.…`) used by MapboxOptions.setAccessToken.
# Mapbox → Account → Access tokens.
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_TOKEN

# --- RevenueCat -----------------------------------------------------------
# Public SDK client identifiers. They are visible in any distributed app and
# only authorize the client SDK; they are not confidential server secrets.
# RevenueCat → Project → API keys.
REVENUECAT_APPLE_KEY=YOUR_REVENUECAT_APPLE_KEY
REVENUECAT_GOOGLE_KEY=YOUR_REVENUECAT_GOOGLE_KEY

# --- Firebase (optional) --------------------------------------------------
# The Firebase Web API key is a client identifier visible in distributed
# apps, not a confidential server credential. Restrict it in Google Cloud.
# When these four are set they override the native platform config files
# (android/app/google-services.json, ios/Runner/GoogleService-Info.plist).
# Firebase Console → Project settings → General → Your apps.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Optional.
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=

# --- Android build (optional) ---------------------------------------------
# Secret Mapbox downloads token, used by android/build.gradle.kts to fetch
# the Mapbox Maven artifacts. Mapbox → Account → Access tokens → Secret token.
MAPBOX_DOWNLOADS_TOKEN=YOUR_MAPBOX_DOWNLOADS_TOKEN
