{
  "name": "tripmetic-functions",
  "description": "Tripmetic Cloud Functions — promo redeem, admin, FCM",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions --project \"$FIREBASE_PROJECT_ID\"",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "private": true
}
